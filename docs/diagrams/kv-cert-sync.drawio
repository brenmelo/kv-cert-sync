<mxCell id="d2" value="&lt;b style=&quot;font-size:12px&quot;&gt;Vault that still uses access policies&lt;/b&gt;&lt;br&gt;The factory role assignment is ignored. Add an access policy (get, list, import) for the sync identity by hand. Do not bundle an RBAC migration with this change" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=58;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#323130;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.75;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1355" y="315" width="490" height="120" as="geometry"/></mxCell>
