<mxCell id="tested" value="&lt;b style=&quot;font-size:13px;color:#107C10&quot;&gt;TESTED (proof of concept, public endpoints)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#323130;fillColor=#F4FAF4;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="725" width="905" height="325" as="geometry"/></mxCell>
<mxCell id="t87" value="&amp;bull;&amp;nbsp;The event path, renewal, sync, tags, adoption of an existing copy and a destination outage (sections 2, 4 and 6 of the test report)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="58" y="770" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="t88" value="&amp;bull;&amp;nbsp;The least-privilege design, with an audit of every role assignment and an ABAC condition that hides the CA secret." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="58" y="820" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="t89" value="&amp;bull;&amp;nbsp;Three alert rules fired and cleared by themselves, and the alert e-mails were delivered." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="58" y="870" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="t90" value="&amp;bull;&amp;nbsp;Terraform: 64 offline tests, fmt and validate on every root, and a plan of the production root with no drift." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="58" y="920" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="t91" value="&amp;bull;&amp;nbsp;One Application Gateway reading a copy, and its forced refresh." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="58" y="970" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="untested" value="&lt;b style=&quot;font-size:13px;color:#B90000&quot;&gt;NOT TESTED (needs your environment)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#323130;fillColor=#FDF3F3;strokeColor=#B90000;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="965" y="725" width="895" height="325" as="geometry"/></mxCell>
<mxCell id="t92" value="&amp;bull;&amp;nbsp;Applying the production root at all: private endpoints, VNet-integrated apps, and the zip deployment with a remote build over the private path." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="770" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="t93" value="&amp;bull;&amp;nbsp;A remote Terraform backend, and DNS records registered by policy instead of by the module." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="820" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="t94" value="&amp;bull;&amp;nbsp;Private destination vaults, vaults with access policies, and the line of sight between the function subnets and every destination vault." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="870" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="t95" value="&amp;bull;&amp;nbsp;A real DigiCert order, DNS validation, and the 46- and 47-day cadence on a live account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="920" width="870" height="44" as="geometry"/></mxCell>
<mxCell id="t96" value="&amp;bull;&amp;nbsp;Azure Government, AKS, API Management and Front Door as consumers." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="970" width="870" height="44" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>