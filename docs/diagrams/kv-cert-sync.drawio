<mxCell id="l74" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.75;strokeColor=#323130;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="754" as="sourcePoint"/><mxPoint x="1430" y="780" as="targetPoint"/><Array as="points"><mxPoint x="1494" y="754"/><mxPoint x="1494" y="780"/></Array></mxGeometry></mxCell>
<mxCell id="t75" value="verify: read back, thumbprint and bytes identical; log KVSYNC result=copied" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=#F4FAF4;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1502" y="750" width="360" height="34" as="geometry"/></mxCell>
<mxCell id="t76" value="The two copies landed 2 s and 43 s after the merge. The event path varied between 2 s and about 2 min in the lab, which is why the timer sweep exists." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#605E5C;fillColor=#F4FAF4;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="160" y="806" width="1680" height="34" as="geometry"/></mxCell>
<mxCell id="l77" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.75;strokeColor=#323130;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="912" as="sourcePoint"/><mxPoint x="1670" y="912" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="t78" value="verify (operator): same thumbprint everywhere; sign with the source key, verify with each copy" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=#FFF8E1;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="238" y="882" width="1424" height="28" as="geometry"/></mxCell>
<mxCell id="l79" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.75;strokeColor=#323130;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="940" as="sourcePoint"/><mxPoint x="1430" y="966" as="targetPoint"/><Array as="points"><mxPoint x="1494" y="940"/><mxPoint x="1494" y="966"/></Array></mxGeometry></mxCell>
<mxCell id="t80" value="timer sweep (5 min here, 15 by default): same sync, result converged-noop" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=#FFF8E1;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1502" y="936" width="360" height="34" as="geometry"/></mxCell>
<mxCell id="l81" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.75;strokeColor=#323130;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="976" as="sourcePoint"/><mxPoint x="470" y="1002" as="targetPoint"/><Array as="points"><mxPoint x="534" y="976"/><mxPoint x="534" y="1002"/></Array></mxGeometry></mxCell>
<mxCell id="t82" value="renewal sweep: due when time left is at most min(30 days, a third of the lifetime), or tag kvrenew-now" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=#FFF8E1;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="542" y="972" width="360" height="34" as="geometry"/></mxCell>
<mxCell id="t83" value="&lt;b&gt;Forced rotation test:&lt;/b&gt; tag kvrenew-now=1 on a certificate that was not due. A new key was merged 253 s later (it waits for a sweep). Both destinations followed within 9 s and 2 s and kept the previous version, so a rollback is possible." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="128" y="1010" width="1730" height="34" as="geometry"/></mxCell>
