<mxfile host="app.diagrams.net" agent="kv-cert-sync generator" version="24.0.0"><diagram id="page1" name="Architecture"><mxGraphModel dx="1900" dy="1080" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Issue one TLS certificate once, copy it to every Key Vault&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#1B1B1B;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1820" height="42" as="geometry"/></mxCell>
<mxCell id="t2" value="Terraform hub-and-spoke proof of concept, tested across 3 subscriptions and 3 regions. A renewal function gets the certificate signed, an event-driven sync function copies it, and alerts tell the owners when something breaks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#605E5C;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1820" height="44" as="geometry"/></mxCell>
