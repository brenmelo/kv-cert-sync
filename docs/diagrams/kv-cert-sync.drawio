<mxCell id="t85" value="terraform/production. Planned (60 resources to add, 0 to change, 0 to destroy) and never applied. It needs a network that already exists, and an apply host that can reach private endpoints." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#605E5C;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1820" height="44" as="geometry"/></mxCell>
