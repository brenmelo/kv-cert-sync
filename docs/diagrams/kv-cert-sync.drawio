<mxCell id="wlB" value="&lt;b style=&quot;font-size:12px&quot;&gt;Consumers (not deployed here)&lt;/b&gt;&lt;br&gt;The same versionless secret id in every region: nothing to change on renewal." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#323130;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.75;dashed=1;dashPattern=6 4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1575" y="375" width="270" height="125" as="geometry"/></mxCell>
