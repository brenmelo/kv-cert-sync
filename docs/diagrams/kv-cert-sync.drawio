<mxCell id="b8" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="688" y="153" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="b9" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1235" y="220.5" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="b10" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1062" y="393" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="b11" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="913" y="468" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t12" value="read certificate + private key" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#107C10;fillColor=#F3F9FE;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="724" y="150" width="300" height="22" as="geometry"/></mxCell>
<mxCell id="t13" value="order, signed chain back" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#605E5C;fillColor=#F8F8F8;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="262" y="472" width="88" height="30" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b style=&quot;font-size:13px&quot;&gt;HOW IT WORKS&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#323130;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="725" width="905" height="325" as="geometry"/></mxCell>
<mxCell id="b14" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="766" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t15" value="The operator (or a pipeline) creates the request in the factory vault: issuer Unknown, exportable key, tags &lt;b&gt;kvsync&lt;/b&gt; (which vaults) and &lt;b&gt;kvrenew=on&lt;/b&gt;. Key Vault returns a pending CSR and publishes no event." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="764" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="b16" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="797" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t17" value="The renewal function sends the CSR to the CA (DigiCert: an order, or a reissue inside an existing order; PoC: a private test CA) and polls for the signed chain." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="795" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="b18" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="828" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t19" value="It merges the chain (leaf first) into the factory vault: a new version. In CSR mode Key Vault never merges by itself. Renewals repeat this when the certificate is due." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="826" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="b20" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="859" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t21" value="Key Vault publishes &lt;b&gt;CertificateNewVersionCreated&lt;/b&gt; and &lt;b&gt;CertificateNearExpiry&lt;/b&gt; to an Event Grid system topic." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="857" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="b22" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="890" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t23" value="A Storage queue takes the event and the sync function reads it. A timer sweep repeats the same work (5 min here, 15 by default): it heals missed events, late opt-ins and deleted copies." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="888" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="b24" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="921" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t25" value="The sync function reads the certificate and private key from the factory vault and checks that they match. It cannot read the CA secret." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="919" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="b26" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="952" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t27" value="It imports the certificate into every opted-in destination vault, in any subscription (read + import only), stamps provenance tags, then verifies thumbprint and bytes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="950" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="b28" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="983" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t29" value="Every run logs &lt;b&gt;KVSYNC / KVRENEW result=...&lt;/b&gt; to Application Insights. The audit logs of every vault go to the same workspace." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="981" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="b30" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="1014" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="t31" value="Four alert rules query the workspace and e-mail the owners: failures, a copy about to expire, and no heartbeat from either function." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="1012" width="852" height="29" as="geometry"/></mxCell>
<mxCell id="proof" value="&lt;b style=&quot;font-size:13px;color:#107C10&quot;&gt;WHAT THE TEST PROVED&lt;/b&gt; &amp;nbsp;(20-21 Oct 2026, three subscriptions, three regions)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#323130;fillColor=#F4FAF4;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="965" y="725" width="895" height="325" as="geometry"/></mxCell>
<mxCell id="t32" value="&amp;bull;&amp;nbsp;&lt;b&gt;Hands-off from request to copies.&lt;/b&gt; The renewal function ordered and merged in 122 s (test CA); the copies landed 2 s and 43 s after the merge, across subscriptions and regions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="760" width="870" height="38" as="geometry"/></mxCell>
<mxCell id="t33" value="&amp;bull;&amp;nbsp;&lt;b&gt;Same certificate, same private key&lt;/b&gt; in all three vaults (thumbprint and public modulus). A copy carries provenance tags and never the opt-in or renewal tags." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="801" width="870" height="38" as="geometry"/></mxCell>
<mxCell id="t34" value="&amp;bull;&amp;nbsp;&lt;b&gt;Edge cases:&lt;/b&gt; 11 of 11 assertions (non-exportable key, one destination, name collision, loop guard, late opt-in, disabled, imported PFX, adoption). The event path took 2 s to about 2 min, so the timer matters." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="842" width="870" height="38" as="geometry"/></mxCell>
<mxCell id="t35" value="&amp;bull;&amp;nbsp;&lt;b&gt;Least privilege, audited:&lt;/b&gt; 14 of 14 checks. The audit found that the sync identity could read the CA secret; an ABAC condition on &lt;b&gt;ca-&lt;/b&gt; names fixed it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="883" width="870" height="38" as="geometry"/></mxCell>
<mxCell id="t36" value="&amp;bull;&amp;nbsp;&lt;b&gt;Alerts fire in about a minute&lt;/b&gt; and clear 25 min to 1 h 45 min after the fix. A destination outage healed by itself 160 s after access returned." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="924" width="870" height="38" as="geometry"/></mxCell>
<mxCell id="t37" value="&amp;bull;&amp;nbsp;&lt;b&gt;Application Gateway:&lt;/b&gt; served the vault certificate; a forced refresh took 60 s; the unattended 4 h pickup was not concluded (the gateway was stopped by something else)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="965" width="870" height="38" as="geometry"/></mxCell>
<mxCell id="t38" value="&amp;bull;&amp;nbsp;&lt;b&gt;Not tested:&lt;/b&gt; a real DigiCert order (needs payment and a DNS record), the private production stack (planned only), Azure Government." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#323130;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="978" y="1006" width="870" height="38" as="geometry"/></mxCell>
</root></mxGraphModel></diagram><diagram id="page2" name="Sequence"><mxGraphModel dx="1900" dy="1080" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t39" value="&lt;b&gt;Sequence: request once, renew, copy everywhere, verify&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontColor=#1B1B1B;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1820" height="40" as="geometry"/></mxCell>
<mxCell id="t40" value="Timings are from the end-to-end test (test CA, 5-minute sweeps). Phase A is a request that a person makes once; everything after it is automatic." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#605E5C;fillColor=none;strokeColor=none;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1820" height="26" as="geometry"/></mxCell>
<mxCell id="ph1" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#323130;fillColor=#F3F9FE;strokeColor=#0078D4;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="1750" height="238" as="geometry"/></mxCell>
<mxCell id="ph2" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#323130;fillColor=#F4FAF4;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="120" y="406" width="1750" height="450" as="geometry"/></mxCell>
<mxCell id="ph3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#323130;fillColor=#FFF8E1;strokeColor=#B58105;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="120" y="864" width="1750" height="182" as="geometry"/></mxCell>
<mxCell id="ph1-t" value="A. REQUEST AND ISSUE" style="text;html=1;horizontal=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#0078D4;fillColor=none;strokeColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="124" y="160" width="24" height="238" as="geometry"/></mxCell>
<mxCell id="ph2-t" value="B. DISTRIBUTE (AUTOMATIC)" style="text;html=1;horizontal=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#107C10;fillColor=none;strokeColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="124" y="406" width="24" height="450" as="geometry"/></mxCell>
<mxCell id="ph3-t" value="C. SAFETY NET AND PROOF" style="text;html=1;horizontal=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#8A5A00;fillColor=none;strokeColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="124" y="864" width="24" height="182" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b style=&quot;font-size:12px&quot;&gt;Operator / pipeline&lt;/b&gt;&lt;br&gt;Certificates Officer on the&lt;br&gt;factory vault only" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=58;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#323130;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.75;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="120" y="84" width="220" height="66" as="geometry"/></mxCell>
<mxCell id="p1-i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;image=data:image/svg+xml,%3Csvg%20id%3D%22e24671f6-f501-4952-a2db-8b0b1d329c17%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2218%22%20height%3D%2218%22%20viewBox%3D%220%200%2018%2018%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22be92901b-ec33-4c65-adf1-9b0eed06d677%22%20x1%3D%229%22%20y1%3D%226.88%22%20x2%3D%229%22%20y2%3D%2220.45%22%20gradientUnits%3D%22userSpaceOnUse%22%3E%3Cstop%20offset%3D%220.22%22%20stop-color%3D%22%2332d4f5%22%20%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23198ab3%22%20%2F%3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%22b46fc246-25d8-4398-8779-1042e8cacae7%22%20x1%3D%228.61%22%20y1%3D%22-0.4%22%20x2%3D%229.6%22%20y2%3D%2211.92%22%20gradientUnits%3D%22userSpaceOnUse%22%3E%3Cstop%20offset%3D%220.22%22%20stop-color%3D%22%2332d4f5%22%20%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23198ab3%22%20%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Ctitle%3EIcon-identity-230%3C%2Ftitle%3E%3Cpath%20d%3D%22M15.72%2C18a1.45%2C1.45%2C0%2C0%2C0%2C1.45-1.45.47.47%2C0%2C0%2C0%2C0-.17C16.59%2C11.81%2C14%2C8.09%2C9%2C8.09S1.34%2C11.24.83%2C16.39A1.46%2C1.46%2C0%2C0%2C0%2C2.14%2C18H15.72Z%22%20fill%3D%22url%28%23be92901b-ec33-4c65-adf1-9b0eed06d677%29%22%20%2F%3E%3Cpath%20d%3D%22M9%2C9.17a4.59%2C4.59%2C0%2C0%2C1-2.48-.73L9%2C14.86l2.44-6.38A4.53%2C4.53%2C0%2C0%2C1%2C9%2C9.17Z%22%20fill%3D%22%23fff%22%20opacity%3D%220.8%22%20%2F%3E%3Ccircle%20cx%3D%229.01%22%20cy%3D%224.58%22%20r%3D%224.58%22%20fill%3D%22url%28%23b46fc246-25d8-4398-8779-1042e8cacae7%29%22%20%2F%3E%3C%2Fsvg%3E" vertex="1" parent="1"><mxGeometry x="130" y="94" width="34" height="34" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b style=&quot;font-size:12px&quot;&gt;Renewal function&lt;/b&gt;&lt;br&gt;UAMI (renew)&lt;br&gt;orders and merges" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=58;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#323130;fillColor=#FFFFFF;strokeColor=#D35400;strokeWidth=1.75;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="360" y="84" width="220" height="66" as="geometry"/></mxCell>
<mxCell id="p2-i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;image=data:image/svg+xml,%3Csvg%20id%3D%22a2c88306-fa03-4e5b-b192-401f0b77808b%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2218%22%20height%3D%2218%22%20viewBox%3D%220%200%2018%2018%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22b403aca7-f387-4434-96b4-ae157edc835f%22%20x1%3D%22-175.993%22%20y1%3D%22-343.723%22%20x2%3D%22-175.993%22%20y2%3D%22-359.232%22%20gradientTransform%3D%22translate%28212.573%20370.548%29%20scale%281.156%201.029%29%22%20gradientUnits%3D%22userSpaceOnUse%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23fea11b%22%20%2F%3E%3Cstop%20offset%3D%220.284%22%20stop-color%3D%22%23fea51a%22%20%2F%3E%3Cstop%20offset%3D%220.547%22%20stop-color%3D%22%23feb018%22%20%2F%3E%3Cstop%20offset%3D%220.8%22%20stop-color%3D%22%23ffc314%22%20%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23ffd70f%22%20%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Ctitle%3EIcon-compute-29%3C%2Ftitle%3E%3Cg%3E%3Cpath%20d%3D%22M2.37%2C7.475H3.2a.267.267%2C0%2C0%2C1%2C.267.267v6.148a.533.533%2C0%2C0%2C1-.533.533H2.1a0%2C0%2C0%2C0%2C1%2C0%2C0V7.741a.267.267%2C0%2C0%2C1%2C.267-.267Z%22%20transform%3D%22translate%2812.507%2016.705%29%20rotate%28134.919%29%22%20fill%3D%22%2350e6ff%22%20%2F%3E%3Cpath%20d%3D%22M2.325%2C3.6h.833a.267.267%2C0%2C0%2C1%2C.267.267v6.583a0%2C0%2C0%2C0%2C1%2C0%2C0H2.591a.533.533%2C0%2C0%2C1-.533-.533V3.865A.267.267%2C0%2C0%2C1%2C2.325%2C3.6Z%22%20transform%3D%22translate%285.759%200.114%29%20rotate%2844.919%29%22%20fill%3D%22%231490df%22%20%2F%3E%3C%2Fg%3E%3Cg%3E%3Cpath%20d%3D%22M14.53%2C7.475h.833a.533.533%2C0%2C0%2C1%2C.533.533v6.148a.267.267%2C0%2C0%2C1-.267.267H14.8a.267.267%2C0%2C0%2C1-.267-.267V7.475a0%2C0%2C0%2C0%2C1%2C0%2C0Z%22%20transform%3D%22translate%2812.223%20-7.555%29%20rotate%2845.081%29%22%20fill%3D%22%2350e6ff%22%20%2F%3E%3Cpath%20d%3D%22M15.108%2C3.6h.833a0%2C0%2C0%2C0%2C1%2C0%2C0v6.583a.267.267%2C0%2C0%2C1-.267.267h-.833a.267.267%2C0%2C0%2C1-.267-.267V4.131a.533.533%2C0%2C0%2C1%2C.533-.533Z%22%20transform%3D%22translate%2831.022%201.222%29%20rotate%28135.081%29%22%20fill%3D%22%231490df%22%20%2F%3E%3C%2Fg%3E%3Cpath%20d%3D%22M8.459%2C9.9H4.87a.193.193%2C0%2C0%2C1-.2-.181.166.166%2C0%2C0%2C1%2C.018-.075L8.991%2C1.13a.206.206%2C0%2C0%2C1%2C.186-.106h4.245a.193.193%2C0%2C0%2C1%2C.2.181.165.165%2C0%2C0%2C1-.035.1L8.534%2C7.966h4.928a.193.193%2C0%2C0%2C1%2C.2.181.176.176%2C0%2C0%2C1-.052.122L5.421%2C16.788c-.077.046-.624.5-.356-.189h0Z%22%20fill%3D%22url%28%23b403aca7-f387-4434-96b4-ae157edc835f%29%22%20%2F%3E%3C%2Fsvg%3E" vertex="1" parent="1"><mxGeometry x="370" y="94" width="34" height="34" as="geometry"/></mxCell>
